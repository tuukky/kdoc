    {
      "id": "5bffbdf5-8745-5665-91bf-1aea36582b9b",
      "name": "조회 조건",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        100
      ],
      "parameters": {
        "jsCode": "// 검색 기간: 어제~오늘 (게시일). 같은 공고는 kdoc-api 가 'seen' 으로 걸러 다시 처리하지 않는다.\n// 지난 날짜로 시험하려면 OVERRIDE 에 { start: '20261110', end: '20261110' } 처럼 넣고 [수동 실행].\nconst OVERRIDE = null;\nconst KEYWORDS = ['화장실', '방수', '외벽', '도장', '타일', '창호', '단열', '리모델링'];  // PLAN_v2 §4.1\nconst ymd = (d) => new Date(d.getTime() + 9 * 3600e3).toISOString().slice(0, 10).replace(/-/g, '');  // KST\nconst now = new Date();\nconst start = OVERRIDE?.start ?? ymd(new Date(now.getTime() - 24 * 3600e3));\nconst end = OVERRIDE?.end ?? ymd(now);\nreturn KEYWORDS.map((keyword) => ({ json: { keyword, start, end, started: now.toISOString() } }));\n"
      }
    },
    {
      "id": "da48efee-f155-5af6-abd4-822b295bde3b",
      "name": "나라장터 검색",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        100
      ],
      "parameters": {
        "method": "POST",
        "url": "https://www.g2b.go.kr/fi/fiu/fiua/UntySrch/srchTotal.do",
        "options": {
          "timeout": 60000,
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 2000
            }
          }
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ dlSrchParamM: { currentPage: 1, recordCountPerPage: '100', srchSeCd: '', untySrchSeCd: 'BK', bizNm: $json.keyword, bizNo: '', bizYmdDiv: 'pstgDt', bizYmd: '', startBizYmd: $json.start, endBizYmd: $json.end, prcmBsneAreaCd: '조070004', frcpYn: 'N', laseYn: 'N', rsrvYn: 'N', cucUseYn: 'N' } }) }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "User-Agent",
              "value": "kdoc-research/0.2 (+https://github.com/tuukky/kdoc)"
            },
            {
              "name": "Referer",
              "value": "https://www.g2b.go.kr/"
            }
          ]
        }
      },
      "notes": "키워드 사이 2초 (PLAN_v2 §4.4). 사이트가 응답하지 않으면 3회 재시도 후 실행 실패 → W4-err",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "id": "2f524469-d63d-5566-8a0f-53db8e176d51",
      "name": "공고 정리·필터",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        100
      ],
      "parameters": {
        "jsCode": "// PLAN_v2 §4.1 (사전 등록): 공사 입찰공고 · 제외 공종 · 추정가격 10억 원 이하 · 하루 30건\nconst EXCLUDE = /(전기|통신|소방|기계설비|조경|토목|포장)\\s*공사/;\nconst PRICE_MAX = 1_000_000_000;\nconst DAILY_MAX = 30;\nconst conds = $('조회 조건').all().map((i) => i.json);\nconst clean = (s) => String(s ?? '').replace(/&lt;\\/?b&gt;|<\\/?b>/g, '').replace(/&#40;/g, '(').replace(/&#41;/g, ')')\n  .replace(/&quot;/g, '\"').replace(/&#39;/g, \"'\").replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&amp;/g, '&').trim();\nlet found = 0;\nconst byKey = new Map();\nconst perKeyword = {};\n$input.all().forEach((it, i) => {\n  const r = it.json;\n  if (!r || !Array.isArray(r.dlTotalSrchL) || !r.dlSetParamM) {\n    throw new Error('나라장터 검색 응답 구조가 바뀌었습니다 (dlTotalSrchL 없음) — 수집 중단');\n  }\n  const kw = conds[i]?.keyword ?? '?';\n  const total = r.dlSetParamM.totalSize;\n  perKeyword[kw] = total > r.dlTotalSrchL.length ? `${total} (앞 ${r.dlTotalSrchL.length}건만 조회)` : total;\n  for (const x of r.dlTotalSrchL) {\n    found++;\n    const key = `${x.bizNo}-${x.bizOrd}`;\n    if (!byKey.has(key)) byKey.set(key, { ...x, keyword: kw });\n  }\n});\nconst rows = [...byKey.values()].map((x) => ({\n  bid_no: x.bizNo, bid_ord: x.bizOrd, name: clean(x.bizNm), org: clean(x.pbancInstUntyGrpNm),\n  price: /^\\d+$/.test(String(x.pbancSrchItm03 ?? '')) ? Number(x.pbancSrchItm03) : null,\n  posted: x.pbancPstgDt ?? '', area: x.prcmBsneAreaNm, kind: x.untySrchSeCd, keyword: x.keyword,\n}));\nconst dropped = { '공사 아님': 0, '제외 공종': 0, '금액 초과': 0 };\nconst pass = rows.filter((r) => {\n  if (r.kind !== 'BK' || r.area !== '공사') { dropped['공사 아님']++; return false; }\n  if (EXCLUDE.test(r.name)) { dropped['제외 공종']++; return false; }\n  if (r.price !== null && r.price > PRICE_MAX) { dropped['금액 초과']++; return false; }\n  return true;\n}).sort((a, b) => String(b.posted).localeCompare(String(a.posted)));\n// 하루 상한(DAILY_MAX)은 '새로 등록하는 공고' 수에 적용한다 (kdoc-api 가 셈). 이미 본 공고는 세지 않는다.\nconst todo = pass;\nconst stats = {\n  기간: `${conds[0].start}~${conds[0].end}`, started: conds[0].started, 검색결과: found, 공고수: rows.length,\n  키워드별: perKeyword, 제외: dropped, 필터통과: pass.length, 하루상한: DAILY_MAX,\n  금액없음: pass.filter((r) => r.price === null).length,\n};\nif (!todo.length) return [{ json: { empty: true, stats } }];\nreturn todo.map((r) => ({ json: { ...r, revised: r.bid_ord !== '000', daily_limit: DAILY_MAX, stats } }));\n"
      }
    },
