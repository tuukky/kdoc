    {
      "id": "ad178dee-68e2-5899-ae8f-0372c446ad6d",
      "name": "등록 결과",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        80
      ],
      "parameters": {
        "jsCode": "const detail = (r) => r?.body?.detail ?? r?.body ?? r?.error?.message ?? r?.error ?? '응답 없음';\nconst httpText = (r) => `HTTP ${r?.statusCode ?? '-'}: ${typeof detail(r) === 'string' ? detail(r) : JSON.stringify(detail(r))}`.slice(0, 500);\nconst won = (n) => n == null ? '없음' : String(n).replace(/\\B(?=(\\d{3})+(?!\\d))/g, ',') + '원';\n\nconst bid = $('공고 하나씩').item.json;\nconst r = $json;\n// 사이트가 막았거나 하루 요청 상한 → 그날 수집 중단 (§4.4). 실행 실패 → W4-err 가 기록·알림\nif (r.statusCode === 503) throw new Error(`나라장터 수집 중단: ${httpText(r)}`);\nconst project = r.body?.project ?? `G-${bid.bid_no}-${bid.bid_ord}`;\nif (r.statusCode >= 200 && r.statusCode < 300) {\n  const go = r.body.status === 'new' && r.body.ready;\n  return { json: { ...bid, project, next: go ? 'fetch' : 'skip', reason: go ? '' : ({ seen: '이미 처리한 공고', deferred: '하루 상한' }[r.body.status] ?? r.body.reason) } };\n}\nreturn { json: { ...bid, project, next: 'fail', step: '공고 등록', reason: httpText(r) } };\n",
        "mode": "runOnceForEachItem"
      }
    },
