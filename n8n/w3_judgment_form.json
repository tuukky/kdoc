    {
      "id": "db16a325-767f-5564-aebb-2f1f11ad5e8c",
      "name": "판정 저장",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        -100
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ 'http://kdoc-api:8000/reviews/' + $json.id + '/judgments' }}",
        "options": {
          "timeout": 120000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "json"
            }
          }
        },
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "parameterType": "formBinaryData",
              "name": "file",
              "inputDataFieldName": "file"
            }
          ]
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "9bc90780-bf12-5db0-8071-d7c11185445b",
      "name": "결과 정리",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        -100
      ],
      "parameters": {
        "jsCode": "const detail = (r) => r?.body?.detail ?? r?.body ?? r?.error?.message ?? r?.error ?? '응답 없음';\nconst httpText = (r) => `HTTP ${r?.statusCode ?? '-'}: ${typeof detail(r) === 'string' ? detail(r) : JSON.stringify(detail(r))}`.slice(0, 500);\nconst won = (n) => n == null ? '없음' : String(n).replace(/\\B(?=(\\d{3})+(?!\\d))/g, ',') + '원';\n\nconst r = $json;\nif (r.statusCode !== 200) return { json: { ok: false, message: httpText(r) } };\nconst b = r.body;\nconst p = b.precision['전체'];\nconst pct = p['정밀도'] == null ? '아직 없음' : `${(p['정밀도'] * 100).toFixed(1)}%`;\nconst message = [\n  `${b.project}: ${b.saved}개 판정 저장 (진짜 문제 ${b.counts['진짜 문제']} · 문제 아님 ${b.counts['문제 아님']} · 판단 못 함 ${b.counts['판단 못 함']})`,\n  `전체 정밀도 ${pct} — 진짜 문제 ${p['진짜 문제']} / (진짜 문제 + 문제 아님 ${p['문제 아님']}), 판단 못 함 ${p['판단 못 함']}는 제외`,\n].join('\\n');\nreturn { json: { ok: true, message, alert: { kind: 'judgment', severity: 'info', title: `[판정 저장] ${b.project}`, body: message, project: b.project } } };\n",
        "mode": "runOnceForEachItem"
      }
    },
