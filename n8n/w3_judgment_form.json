      ],
      "parameters": {
        "formTitle": "kdoc 판정 올리기",
        "formDescription": "결과 엑셀의 '판정' 열(진짜 문제 / 문제 아님 / 판단 못 함)을 채운 뒤 올리십시오. 검토 ID 는 알림함의 검토 완료 알림에 있습니다. 같은 항목을 다시 올리면 새 판정으로 바뀝니다.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "검토 ID",
              "fieldType": "text",
              "requiredField": true,
              "placeholder": "예: 3f2b8c1e-...."
            },
            {
              "fieldLabel": "판정한 결과 엑셀",
              "fieldType": "file",
              "multipleFiles": false,
              "acceptFileTypes": ".xlsx",
              "requiredField": true
            }
          ]
        },
        "responseMode": "lastNode",
        "options": {}
      },
      "webhookId": "af286666-a390-536a-8181-6563035dbc39"
    },
    {
      "id": "5a320056-d316-52ba-9f6e-705d4284e7aa",
      "name": "입력 확인",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "const item = $input.first();\nconst id = String(item.json['검토 ID'] ?? '').trim();\nconst file = Object.values(item.binary ?? {}).find((f) => String(f.fileName ?? '').toLowerCase().endsWith('.xlsx'));\nconst ok = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(id) && !!file;\nreturn [{ json: { id, ok, message: ok ? '' : '검토 ID 형식(UUID) 또는 .xlsx 파일을 확인하십시오.' }, binary: file ? { file } : {} }];\n"
      }
    },
    {
      "id": "d01090db-721c-5692-ac65-927bd699dd97",
      "name": "입력 올바름?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "dedaf38d-160d-5bee-a078-8512ce8926d0",
              "leftValue": "={{ $json.ok }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
