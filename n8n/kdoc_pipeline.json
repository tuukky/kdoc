{
  "name": "kdoc 수집→추출",
  "nodes": [
    {
      "parameters": {},
      "id": "a1f0c6e2-0001-4000-8000-000000000001",
      "name": "수동 실행",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 0]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "p1", "name": "project", "value": "P1", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "a1f0c6e2-0001-4000-8000-000000000002",
      "name": "대상 프로젝트",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [220, 0]
    },
    {
      "parameters": {
        "command": "=cd /work && python3 -m kdoc fetch --project {{ $json.project }}"
      },
      "id": "a1f0c6e2-0001-4000-8000-000000000003",
      "name": "fetch (파이썬)",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [440, 0],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://kdoc-api:8000/extract",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ project: $('대상 프로젝트').item.json.project }) }}",
        "options": { "timeout": 600000 }
      },
      "id": "a1f0c6e2-0001-4000-8000-000000000004",
      "name": "extract (kdoc-api)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [660, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 2 },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.ok }}",
              "rightValue": "",
              "operator": { "type": "boolean", "operation": "true", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1f0c6e2-0001-4000-8000-000000000005",
      "name": "추출 성공?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [880, 0]
    },
    {
      "parameters": {},
      "id": "a1f0c6e2-0001-4000-8000-000000000006",
      "name": "성공 (다음: 비교·알림)",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [1100, -100]
    },
    {
      "parameters": {},
      "id": "a1f0c6e2-0001-4000-8000-000000000007",
      "name": "문서 오류 있음 (다음: 알림)",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [1100, 100]
    }
  ],
  "connections": {
    "수동 실행": { "main": [[{ "node": "대상 프로젝트", "type": "main", "index": 0 }]] },
    "대상 프로젝트": { "main": [[{ "node": "fetch (파이썬)", "type": "main", "index": 0 }]] },
    "fetch (파이썬)": { "main": [[{ "node": "extract (kdoc-api)", "type": "main", "index": 0 }]] },
    "extract (kdoc-api)": { "main": [[{ "node": "추출 성공?", "type": "main", "index": 0 }]] },
    "추출 성공?": {
      "main": [
        [{ "node": "성공 (다음: 비교·알림)", "type": "main", "index": 0 }],
        [{ "node": "문서 오류 있음 (다음: 알림)", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": { "executionOrder": "v1" },
  "pinData": {}
}
