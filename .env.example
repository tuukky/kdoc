# 2단계(비교)부터 사용. 추출 단계는 키 없이 동작한다.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# 실행 1회당 LLM 호출 상한 (비용 안전장치)
LLM_MAX_CALLS_PER_RUN=200

# ---- v2 운영 자동화 (PLAN_v2) ----
# 업로드 검토(POST /reviews/upload) 파일당 상한 (MB)
KDOC_UPLOAD_MAX_MB=50
# 운영 기록 DB (공고·실행·실패·판정)
KDOC_OPS_DB=data/ops/kdoc.db
# 공공데이터 키·OpenAI 키(W5)는 여기에 쓰지 않고 n8n 자격 증명에 저장한다.
